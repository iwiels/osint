{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "specter-osint": {
        "type": "local",
        "command": [
          "uv",
          "--directory",
          "<ABSOLUTE_PATH_TO_THIS_REPO>",
          "run",
          "python",
          "-m",
          "specter.server"
        ],
        "env": {
          "PYTHONPATH": "<ABSOLUTE_PATH_TO_THIS_REPO>/engine"
        },
        "enabled": true
      }
    }
  }
}
