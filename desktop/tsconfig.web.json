{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    // Los tests corren con el runner nativo de Node (`node --test`), que
    // ejecuta TypeScript por type-stripping y NO resuelve extensiones: el
    // import debe llevar el `.ts` explícito. Válido porque `noEmit` está activo.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@wraith/sdk": ["../packages/sdk/src/index.ts"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts",
    "../packages/sdk/src/**/*"
  ]
}
