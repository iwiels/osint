{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@specter/sdk": ["../packages/sdk/src/index.ts"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts",
    "../packages/sdk/src/**/*"
  ]
}
