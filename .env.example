# WraithOSINT — Variables de entorno del engine (motor Python)
#
# Copia este archivo a .env y rellena lo que uses (el archivo .env está en
# .gitignore y NUNCA se commitea). El motor lee el entorno del proceso: no hay
# carga automática de .env — exporta las variables o configúralas desde la UI
# (Ajustes → Credenciales guarda en la bóveda local con permisos 0600).
#
# Las claves API son OPCIONALES: sin ellas los colectores correspondientes se
# omiten en silencio y el resto del motor funciona igual.

# ------------------------------------------------------------------
# Motor (paths y transporte)
# ------------------------------------------------------------------

# Puerto HTTP del engine (por defecto 8787). El sidecar de Electron lo fija.
SPECTER_ENGINE_PORT=8787

# Token Bearer que toda petición (salvo /health) debe presentar.
# En producción el sidecar genera uno aleatorio por arranque; en la API
# standalone (--host no loopback) es obligatorio definirlo.
SPECTER_ENGINE_TOKEN=

# Directorio de datos del motor (SQLite, cache, dataset WMN).
# Por defecto: ./data en dev. En la app instalada el sidecar lo fija al
# directorio de datos del usuario que resuelve Electron (`app.getPath("userData")`:
# %APPDATA% en Windows, ~/Library/Application Support en macOS, ~/.config en Linux).
# SPECTER_DATA_DIR=

# Directorio de dossiers generados (HTML/Markdown/STIX/JSON).
# Por defecto: ./reports en dev.
# SPECTER_REPORTS_DIR=

# Ruta alternativa de la base de datos forense (por defecto <data_dir>/specter_osint.db).
# SPECTER_DB_PATH=

# Cache persistente de colectores (diskcache). Por defecto <data_dir>/cache.
# SPECTER_CACHE_DIR=

# Ruta de la bóveda local de secretos. Por defecto <data_dir>/secrets.json.
# SPECTER_SECRETS_PATH=

# Clave HMAC del ledger de custodia (hex o texto). Si no existe se genera
# automáticamente en <data_dir>/ledger.key con permisos 0600.
# SPECTER_LEDGER_KEY=
# SPECTER_LEDGER_KEY_PATH=

# ------------------------------------------------------------------
# Comportamiento del agente y navegación
# ------------------------------------------------------------------

# "1" activa el auto-aprobado de permisos del agente (SOLO para demos;
# por defecto el gate de permisos exige aprobación del analista).
# SPECTER_AUTO_APPROVE=

# "0" desactiva el enforcement SSRF de NetGuard (bloqueo de IPs privadas/
# loopback en peticiones web). NO lo desactives salvo en laboratorio aislado.
# SPECTER_SSRF_ENFORCE=1

# Pool rotatorio de proxies de salida (separados por coma), para repartir
# campañas entre salidas distintas. Los proxies que fallan entran en cuarentena.
# SPECTER_PROXY_POOL=

# ------------------------------------------------------------------
# Setup del desktop (scripts npm)
# ------------------------------------------------------------------

# Python ejecutable del engine (override del venv autodetectado).
# SPECTER_PYTHON=

# Salta la preparación del venv en npm install (postinstall).
# SPECTER_SKIP_ENGINE_SETUP=1

# ------------------------------------------------------------------
# Proveedores LLM (el agente del engine)
# ------------------------------------------------------------------

# Al menos uno si quieres agente IA (o configura la key desde la UI).
# OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ------------------------------------------------------------------
# Threat intel (opcionales — sin key, esos colectores se omiten)
# ------------------------------------------------------------------

# VIRUSTOTAL_API_KEY=
# SHODAN_API_KEY=
# GREYNOISE_API_KEY=
# ABUSEIPDB_API_KEY=
# HUNTER_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# HIBP_API_KEY=
