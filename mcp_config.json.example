{
  "mcpServers": {
    "wraith-osint": {
      "command": "uv",
      "args": [
        "--directory",
        "<ABSOLUTE_PATH_TO_THIS_REPO>",
        "run",
        "python",
        "-m",
        "specter.server"
      ],
      "description": "Servidor MCP de Ciberinteligencia OSINT y Grafos Forenses (WraithOSINT)",
      "env": {
        "PYTHONPATH": "<ABSOLUTE_PATH_TO_THIS_REPO>/engine"
      }
    }
  }
}
