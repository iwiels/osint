# Node
node_modules/
out/
dist/
release/

# Entorno y secretos: nunca commitear credenciales
.env
.env.*
!.env.example

# Engine empaquetado
dist-engine/
build-engine/
engine/.venv/
engine/_build_info.py

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Runtime de investigación: dossiers, evidencias y capturas son datos de caso
# (potencialmente personales) — jamás deben entrar al repositorio
data/*.db
data/*.db-*
data/*.key
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/secrets.json
data/cache/
data/warc/
data/specter_osint.db
# Runtime del engine cuando se arranca desde engine/ (cwd): misma clase de
# artefacto que data/, nunca debe entrar al repo.
engine/data/
reports/*
!reports/.gitkeep

# Cobertura y cachés (artefactos, nunca commitear)
.coverage
coverage/
*.tsbuildinfo
.ruff_cache/

# OpenCode: Specter es ajeno — solo toma prestados los modelos free tier.
# La integración MCP es opt-in: copia opencode.json.example a opencode.json
# solo si quieres exponer las tools en tus propias sesiones de OpenCode.
opencode.json
.opencode/
# Config local de cliente MCP (plantilla con ruta personal): no commitear.
mcp_config.json

# Herramientas locales del entorno de desarrollo: contienen rutas absolutas de
# la máquina y, en el caso de mcp.json, credenciales de servidores MCP.
.perch/
.superpowers/
.freebuff/

# OS / editor
.DS_Store
Thumbs.db
